# ==============================================================================
# Environment Configuration for Interview Platform Backend
# Copy this file to .env and set secure production values before deployment
# ==============================================================================

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=interview_app
DB_USERNAME=postgres
DB_PASSWORD=your_secure_postgres_password

# Security & JWT Configuration (Must be at least 256-bit secure secret)
JWT_SECRET=your_production_256_bit_jwt_secret_key_change_me_before_deploying

# Active Spring Profile (prod for production, dev for local development)
SPRING_PROFILES_ACTIVE=prod

# CORS Configuration (comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://yourproductiondomain.com

